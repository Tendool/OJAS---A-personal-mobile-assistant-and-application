<resources>
    <style name="Theme.Ojas" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/space_void</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowActivityTransitions">true</item>
        <item name="android:colorBackground">@color/space_void</item>
        <item name="android:textColorPrimary">@color/starlight</item>
    </style>

    <style name="Theme.Ojas.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/space_void</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="windowSplashScreenAnimationDuration">400</item>
        <item name="postSplashScreenTheme">@style/Theme.Ojas</item>
    </style>
</resources>
